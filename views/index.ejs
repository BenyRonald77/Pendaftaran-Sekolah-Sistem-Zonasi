<%- include('partials/head') %>

<h1 class="page-title">Pendaftaran Peserta Didik Baru - Sistem Zonasi</h1>
<p class="page-lede">
  Layanan pendaftaran peserta didik baru berbasis sistem zonasi untuk dinas pendidikan dan calon siswa.
</p>

<div class="actions-row">
  <a class="btn btn-secondary" href="/sekolah">Lihat Daftar Sekolah</a>
</div>

<% if (dataError) { %>
  <div class="section">
    <div class="state-box state-error">
      <h3>Data tidak dapat dimuat</h3>
      <p><%= dataError %></p>
    </div>
  </div>
<% } else if (schools.length === 0) { %>
  <div class="section">
    <div class="state-box state-empty">
      <h3>Belum ada sekolah terdaftar</h3>
      <p>Dinas pendidikan belum menambahkan data sekolah.</p>
    </div>
  </div>
<% } else { %>
  <div class="section">
    <h2 class="section-title">Ringkasan saat ini</h2>
    <div class="card-grid">
      <div class="stat-card">
        <span class="stat-value"><%= schools.length %></span>
        <span class="stat-label">Sekolah terdaftar dalam sistem</span>
      </div>
    </div>
  </div>

  <div class="section">
    <h2 class="section-title">Jadwal pengumuman</h2>
    <div class="card">
      <% if (releaseAtFormatted) { %>
        <p class="mt-0">Hasil kelulusan dijadwalkan tayang pada:</p>
        <p style="font-weight:700;font-size:1.1rem;color:var(--color-navy-dark)"><%= releaseAtFormatted %></p>
      <% } else { %>
        <p class="mt-0 text-muted">Jadwal pengumuman belum diatur oleh admin.</p>
      <% } %>
    </div>
  </div>
<% } %>

<%- include('partials/foot') %>
