<%
// Locals wajib: idPrefix, label, latValue, lngValue, latError, lngError
// Locals opsional: defaultLat, defaultLng
const _defaultLat = typeof defaultLat !== 'undefined' ? defaultLat : -6.9147;
const _defaultLng = typeof defaultLng !== 'undefined' ? defaultLng : 107.6098;
%>
<div class="field-group">
  <span class="field-label"><%= label %></span>
  <p class="map-status" data-map-status-for="<%= idPrefix %>-map">Memuat peta...</p>
  <div id="<%= idPrefix %>-map" class="koordinat-map" data-koordinat-map
       data-lat-input="<%= idPrefix %>-lat" data-lng-input="<%= idPrefix %>-lng"
       data-default-lat="<%= _defaultLat %>" data-default-lng="<%= _defaultLng %>"></div>
  <div class="field-row">
    <div class="field">
      <label for="<%= idPrefix %>-lat">Latitude</label>
      <input type="number" step="any" min="-90" max="90" id="<%= idPrefix %>-lat" name="lat"
             value="<%= latValue %>" required>
      <% if (latError) { %><p class="field-error"><%= latError %></p><% } %>
    </div>
    <div class="field">
      <label for="<%= idPrefix %>-lng">Longitude</label>
      <input type="number" step="any" min="-180" max="180" id="<%= idPrefix %>-lng" name="lng"
             value="<%= lngValue %>" required>
      <% if (lngError) { %><p class="field-error"><%= lngError %></p><% } %>
    </div>
  </div>
  <p class="field-hint">Klik peta atau geser pin untuk mengisi koordinat otomatis, atau isi latitude/longitude secara manual jika peta tidak muncul.</p>
</div>
