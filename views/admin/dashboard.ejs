<%- include('../partials/head') %>

<h1 class="page-title">Dasbor Admin</h1>
<p class="page-lede">Ringkasan data sistem zonasi saat ini.</p>

<% if (dataError) { %>
  <div class="state-box state-error">
    <h3>Data tidak dapat dimuat</h3>
    <p><%= dataError %></p>
  </div>
<% } else { %>
  <div class="section">
    <div class="card-grid">
      <div class="stat-card">
        <span class="stat-value"><%= totalSchools %></span>
        <span class="stat-label">Sekolah terdaftar</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= totalRegistrants %></span>
        <span class="stat-label">Total pendaftar</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= countByTrack.zonasi %></span>
        <span class="stat-label">Pendaftar jalur zonasi</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= countByTrack.prestasi %></span>
        <span class="stat-label">Pendaftar jalur prestasi</span>
      </div>
      <div class="stat-card">
        <span class="stat-value"><%= countByTrack.afirmasi %></span>
        <span class="stat-label">Pendaftar jalur afirmasi</span>
      </div>
    </div>
  </div>

  <div class="section">
    <h2 class="section-title">Jadwal Pengumuman</h2>
    <div class="card">
      <% if (releaseAtFormatted) { %>
        <p class="mt-0">
          Rilis: <strong><%= releaseAtFormatted %></strong>
          &mdash;
          <span class="badge <%= released ? 'badge--diterima' : 'badge--menunggu' %>">
            <%= released ? 'Sudah tayang' : 'Belum tayang' %>
          </span>
        </p>
      <% } else { %>
        <p class="mt-0 text-muted">Jadwal belum diatur.</p>
      <% } %>
      <a class="btn btn-secondary btn-sm" href="/admin/jadwal">Ubah Jadwal</a>
    </div>
  </div>

  <div class="section">
    <h2 class="section-title">Ringkasan per Sekolah</h2>
    <% if (schoolSummaries.length === 0) { %>
      <div class="state-box state-empty">
        <h3>Belum ada sekolah</h3>
        <p>Tambahkan data sekolah terlebih dahulu untuk mulai menerima pendaftar.</p>
        <a class="btn btn-primary btn-sm" href="/admin/sekolah/baru">Tambah Sekolah</a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Sekolah</th>
              <th class="numeric">Pendaftar</th>
              <th class="numeric">Sementara Diterima</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% schoolSummaries.forEach(function (item) { %>
              <tr>
                <td><%= item.school.name %></td>
                <td class="numeric"><%= item.totalCount %></td>
                <td class="numeric"><%= item.acceptedCount %></td>
                <td><a class="btn btn-secondary btn-sm" href="/admin/ranking?schoolId=<%= item.school.id %>">Lihat Ranking</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="actions-row">
    <a class="btn btn-primary" href="/admin/sekolah/baru">Tambah Sekolah</a>
    <a class="btn btn-secondary" href="/admin/pendaftar/baru">Tambah Pendaftar</a>
    <a class="btn btn-secondary" href="/admin/pendaftar">Lihat Data Pendaftar</a>
  </div>
<% } %>

<%- include('../partials/foot') %>
