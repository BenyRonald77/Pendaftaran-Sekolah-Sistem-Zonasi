<%- include('partials/head') %>

<h1 class="page-title">Formulir Pendaftaran Peserta Didik Baru</h1>
<p class="page-lede">
  Isi data di bawah ini dengan benar. Jarak rumah ke sekolah tujuan dihitung otomatis oleh sistem
  setelah formulir dikirim, sehingga Anda tidak perlu menghitungnya sendiri.
</p>

<% if (errors._general) { %>
  <div class="alert alert-error"><%= errors._general %></div>
<% } %>

<% if (schools.length === 0) { %>
  <div class="state-box state-empty">
    <h3>Pendaftaran belum dapat dibuka</h3>
    <p>Belum ada data sekolah yang dapat dipilih. Silakan coba lagi setelah dinas pendidikan menambahkan data sekolah.</p>
  </div>
<% } else { %>
  <form method="post" action="/daftar" novalidate>
    <fieldset>
      <legend>Data Diri</legend>
      <div class="field">
        <label for="name">Nama Lengkap</label>
        <input type="text" id="name" name="name" value="<%= values.name || '' %>" required>
        <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
      </div>
      <div class="field">
        <label for="nisn">NISN (Nomor Induk Siswa Nasional)</label>
        <input type="text" inputmode="numeric" id="nisn" name="nisn" value="<%= values.nisn || '' %>" required>
        <p class="field-hint">Simpan NISN ini, dipakai untuk mengecek hasil kelulusan nanti.</p>
        <% if (errors.nisn) { %><p class="field-error"><%= errors.nisn %></p><% } %>
      </div>
    </fieldset>

    <fieldset>
      <legend>Lokasi Rumah</legend>
      <%- include('partials/koordinat-input', {
        idPrefix: 'rumah',
        label: 'Titik lokasi rumah',
        latValue: values.lat || '',
        lngValue: values.lng || '',
        latError: errors.lat,
        lngError: errors.lng
      }) %>
    </fieldset>

    <fieldset>
      <legend>Sekolah dan Jalur</legend>
      <div class="field">
        <label for="schoolId">Sekolah Tujuan</label>
        <select id="schoolId" name="schoolId" required>
          <option value="">-- Pilih sekolah --</option>
          <% schools.forEach(function (school) { %>
            <option value="<%= school.id %>" <%= values.schoolId === school.id ? 'selected' : '' %>>
              <%= school.name %>
            </option>
          <% }); %>
        </select>
        <% if (errors.schoolId) { %><p class="field-error"><%= errors.schoolId %></p><% } %>
      </div>

      <div class="field">
        <label for="track">Jalur Pendaftaran</label>
        <select id="track" name="track" required>
          <option value="">-- Pilih jalur --</option>
          <option value="zonasi" <%= values.track === 'zonasi' ? 'selected' : '' %>><%= TRACK_LABELS.zonasi %> (diurutkan berdasarkan jarak terdekat)</option>
          <option value="prestasi" <%= values.track === 'prestasi' ? 'selected' : '' %>><%= TRACK_LABELS.prestasi %> (diurutkan berdasarkan nilai tertinggi)</option>
          <option value="afirmasi" <%= values.track === 'afirmasi' ? 'selected' : '' %>><%= TRACK_LABELS.afirmasi %> (diurutkan berdasarkan waktu daftar tercepat)</option>
        </select>
        <% if (errors.track) { %><p class="field-error"><%= errors.track %></p><% } %>
      </div>

      <div class="field">
        <label for="achievementScore">Nilai Prestasi (wajib diisi jika memilih jalur Prestasi)</label>
        <input type="number" step="any" min="0" id="achievementScore" name="achievementScore"
               value="<%= values.achievementScore || '' %>">
        <p class="field-hint">Kosongkan jika mendaftar lewat jalur zonasi atau afirmasi.</p>
        <% if (errors.achievementScore) { %><p class="field-error"><%= errors.achievementScore %></p><% } %>
      </div>
    </fieldset>

    <div class="actions-row">
      <button type="submit" class="btn btn-primary">Kirim Pendaftaran</button>
    </div>
  </form>
<% } %>

<%- include('partials/foot') %>
